[gd_scene load_steps=3 format=3 uid="uid://caeplaa1gbdgn"]

[sub_resource type="GDScript" id="GDScript_avjmv"]
resource_name = "affafaffa"
script/source = "extends Node2D

signal passed_by_player 

@export var speed: float = 300.0
var scored := false

func _ready() -> void:
	add_to_group(\"pipes\")
	
	if has_node(\"Area2D\"):
		$Area2D.body_entered.connect(_on_body_entered)

func _process(delta: float) -> void:
	global_position.x -= speed * delta
	
	var player = get_tree().get_first_node_in_group(\"player\")
	
	# To stop the score from triggering before you die:
	# We only score if the pipe is past the player AND the player is not dead
	if player and not player.is_dead and global_position.x < player.global_position.x and global_position.x > 0 and not scored:
		scored = true
		print(\">>> PIPE PASSED! GIVING POINT. <<<\")
		player.add_score()
		
	# Only delete when completely off screen
	if global_position.x < -200:
		queue_free()

func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Player\" or body.name == \"CharacterBody2D\":
		print(\"PIPE HIT PLAYER!\")
		body.die()
"

